{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cervical Guard",
  "version": "0.1.19",
  "identifier": "com.cervicalguard.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "健康提醒 · 姿态与久坐",
        "width": 1338,
        "height": 753,
        "minWidth": 1120,
        "minHeight": 700,
        "backgroundColor": "#f7f8f5",
        "decorations": false,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https://upload.wikimedia.org; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421 https://api.open-meteo.com https://geocoding-api.open-meteo.com https://zh.wikipedia.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMEJEMUM5NUY3MjlCRgpSV1MvS2ZlVkhMM3dBODdXTVhKZWtMNWJ0UHgra1grOVFHWTlKRzNrODBGK0haY09tSERUYW42UQo=",
      "endpoints": [
        "https://github.com/GigaPuddings/cervical-guard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
